rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Checks if requesting user is an active member of the target school
    function isSchoolMember(schoolId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/schoolMembers/$(schoolId + "_" + request.auth.uid)) &&
        get(/databases/$(database)/documents/schoolMembers/$(schoolId + "_" + request.auth.uid)).data.status == 'active';
    }

    // Checks if requesting user is an active principal, admin, or HTAT in the school
    function isSchoolAdminOrPrincipal(schoolId) {
      return isSchoolMember(schoolId) && (
        get(/databases/$(database)/documents/schoolMembers/$(schoolId + "_" + request.auth.uid)).data.roleInSchool == 'principal' ||
        get(/databases/$(database)/documents/schoolMembers/$(schoolId + "_" + request.auth.uid)).data.roleInSchool == 'admin' ||
        get(/databases/$(database)/documents/schoolMembers/$(schoolId + "_" + request.auth.uid)).data.roleInSchool == 'htat'
      );
    }

    // Checks if requesting user is the creator of the target school
    function isSchoolCreator(schoolId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/schools/$(schoolId)) &&
        get(/databases/$(database)/documents/schools/$(schoolId)).data.createdByUid == request.auth.uid;
    }

    // Teacher Profiles: Read/write only own user document
    match /teacherUsers/{userId} {
      allow read, write: if isUser(userId);
    }

    // Schools:
    // - Create: Authenticated user where createdByUid == request.auth.uid
    // - Read: Any active school member
    // - Update: Only principal / admin / htat (ordinary teachers cannot modify sensitive school data)
    // - Delete: Forbidden
    match /schools/{schoolId} {
      allow create: if isAuthenticated() && request.resource.data.createdByUid == request.auth.uid;
      allow read: if isSchoolMember(schoolId);
      allow update: if isSchoolAdminOrPrincipal(schoolId);
      allow delete: if false;
    }

    // School Memberships:
    match /schoolMembers/{membershipId} {
      // Read: A user can read their own membership or all memberships for their school
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || 
        isSchoolMember(resource.data.schoolId)
      );
      
      // Create:
      // Must match membership ID format: {schoolId}_{uid}
      // Allowed ONLY IF:
      // 1) Created by an existing active principal/admin/htat of the school, OR
      // 2) Atomic first-school provisioning by the school creator creating their OWN principal membership:
      //    - School creator (isSchoolCreator) or new school setup
      //    - membership.uid == request.auth.uid
      //    - roleInSchool == 'principal'
      //    - status == 'active'
      allow create: if isAuthenticated() && 
        membershipId == (request.resource.data.schoolId + "_" + request.resource.data.uid) && (
          // Existing active principal/admin/htat adding/inviting a member
          isSchoolAdminOrPrincipal(request.resource.data.schoolId) ||
          // School creator creating their initial principal membership
          (
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.roleInSchool == 'principal' &&
            request.resource.data.status == 'active' &&
            (
              isSchoolCreator(request.resource.data.schoolId) ||
              !exists(/databases/$(database)/documents/schools/$(request.resource.data.schoolId))
            )
          )
        );

      // Update:
      // Immutability: schoolId and uid CANNOT be changed
      // Non-admin users CANNOT:
      // - Change another teacher's membership
      // - Change their own role or status (prevents self-promotion)
      allow update: if isAuthenticated() &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.schoolId == resource.data.schoolId && (
          // Principal/admin/htat updating any member in their school
          isSchoolAdminOrPrincipal(resource.data.schoolId) ||
          // Non-admin member self-updating non-sensitive fields ONLY (role & status remain unchanged)
          (
            resource.data.uid == request.auth.uid &&
            request.resource.data.roleInSchool == resource.data.roleInSchool &&
            request.resource.data.status == resource.data.status
          )
        );

      // Delete: Only principal/admin/htat or user removing their own membership
      allow delete: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || 
        isSchoolAdminOrPrincipal(resource.data.schoolId)
      );
    }

    // Legacy schoolSettings fallback for migration
    match /schoolSettings/{schoolId} {
      allow read, write: if isAuthenticated();
    }

    // Community posts: Owner-protected access
    match /communityPosts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() 
        && ('creatorId' in request.resource.data) 
        && request.resource.data.creatorId == request.auth.uid;
      allow update: if isAuthenticated() 
        && ('creatorId' in resource.data) 
        && resource.data.creatorId == request.auth.uid
        && ('creatorId' in request.resource.data) 
        && request.resource.data.creatorId == request.auth.uid;
      allow delete: if isAuthenticated() 
        && ('creatorId' in resource.data) 
        && resource.data.creatorId == request.auth.uid;
    }

    // Teacher stories, reels & groups (Authenticated access)
    match /teacherStories/{storyId} { allow read, write: if isAuthenticated(); }
    match /teachingReels/{reelId} { allow read, write: if isAuthenticated(); }
    match /teacherGroups/{groupId} { allow read, write: if isAuthenticated(); }

    // Catch-all: Deny all unauthenticated or unhandled collection access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
